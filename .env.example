SUPABASE_URL=
SUPABASE_KEY=
ANTHROPIC_API_KEY=
FRONTEND_URL=https://your-frontend-domain.com
JWT_SECRET=

# Optional — the app runs fine with these unset. Best-effort n8n webhook
# calls are skipped entirely when their URL is blank.
N8N_PHASE_COMPLETE_URL=
N8N_ONBOARDING_URL=

# --- setup_database.py only (not read by app.py) ---------------------------

# Required to run setup_database.py: a direct Postgres connection string
# (Project Settings -> Database -> Connection string -> URI), needed
# because DDL/RLS statements can't go through the SUPABASE_URL REST API.
SUPABASE_DB_URL=

# Optional: creates one admin test user if both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional: lets setup_database.py attempt to enable backups (PITR) via
# the Supabase Management API. SUPABASE_ACCESS_TOKEN is a personal access
# token (Account -> Access Tokens) — a different secret from SUPABASE_KEY.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
